# Default to LF for all text files
* text=auto eol=lf

# Explicit POSIX scripts (Must always be LF)
*.sh text eol=lf

# Explicit Windows batch files (Must be CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code & configs (Enforce LF across all OSes)
*.py text eol=lf
*.lua text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files (Never convert)
*.wasm binary
*.woff2 binary
*.tar.gz binary
*.zip binary
*.enc binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
